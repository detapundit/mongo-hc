[Service]
User=monsum
WorkingDirectory=/opt/monsum/aggregator
ExecStart=/opt/monsum/aggregator/venv/bin/python aggregator.py
Restart=always
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/monsum/aggregator.env


sudo systemctl daemon-reload
sudo systemctl restart monsum-aggregator
sudo systemctl show monsum-aggregator | grep OPENAI
